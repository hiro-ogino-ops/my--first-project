# Claude API キー（未設定でもオフラインのスタブ生成でパイプラインは動きます）
ANTHROPIC_API_KEY=

# 1 にすると API を一切呼ばず、決定論的なスタブ本文を生成します（動作確認・テスト用）
NOTESHOP_OFFLINE=0

# note のブラウザ自動投稿を使う場合のみ設定（既定では使いません。docs/legal-and-risk.md を必読）
NOTE_EMAIL=
NOTE_PASSWORD=

# ---------------------------------------------------------------- spotify-lyrics
# 再生中の曲の歌詞を表示するアプリ（`spotify-lyrics`）で使います。
# https://developer.spotify.com/dashboard でアプリを作り、Redirect URI に
# http://127.0.0.1:8888/callback を登録してから Client ID を入れてください。
# クライアントシークレットは PKCE を使うので不要です。
SPOTIFY_CLIENT_ID=

# 待ち受けポートを変えたいときだけ（ダッシュボードの登録も同じ値にすること）
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# 歌詞が早い/遅いときの補正（ミリ秒、正で早く進む）。表示中は [ ] キーでも変えられます。
SPOTIFY_LYRICS_OFFSET_MS=0
